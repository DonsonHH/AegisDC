{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPS auxiliary comparison field record v1",
  "description": "One load and a fixed prior domain. Null denotes unknown. This record neither grants authorization nor validates field estimates.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aegisdc-ups-field-record-v1"
    },
    "record_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "asset_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "basis": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "DECLARED_FIXTURE",
            "FIELD_RECORD"
          ]
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "legal_actions": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "defer",
              "escalate",
              "direct",
              "inspect"
            ]
          }
        }
      ]
    },
    "fixed_over_prior": {
      "$ref": "#/$defs/flag"
    },
    "leaf_gap_s": {
      "$ref": "#/$defs/exact"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "a": {
          "$ref": "#/$defs/probability"
        },
        "b": {
          "$ref": "#/$defs/probability"
        },
        "q_I": {
          "$ref": "#/$defs/probability"
        },
        "q_R": {
          "$ref": "#/$defs/probability"
        },
        "r_E": {
          "$ref": "#/$defs/probability"
        },
        "d_R": {
          "$ref": "#/$defs/nonnegative"
        },
        "d_FP": {
          "$ref": "#/$defs/nonnegative"
        },
        "d_E": {
          "$ref": "#/$defs/nonnegative"
        },
        "k": {
          "$ref": "#/$defs/nonnegative"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direct_authorized": {
          "$ref": "#/$defs/flag"
        },
        "direct_resource_feasible": {
          "$ref": "#/$defs/flag"
        },
        "inspection_resource_feasible": {
          "$ref": "#/$defs/flag"
        },
        "restore_after_report_authorized": {
          "$ref": "#/$defs/flag"
        },
        "escalation_resource_feasible": {
          "$ref": "#/$defs/flag"
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_at": {
          "$ref": "#/$defs/timestamp"
        },
        "deadline_at": {
          "$ref": "#/$defs/timestamp"
        },
        "direct_completion_at": {
          "$ref": "#/$defs/timestamp"
        },
        "report_available_at": {
          "$ref": "#/$defs/timestamp"
        },
        "conditional_completion_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  },
  "required": [
    "schema"
  ],
  "$defs": {
    "flag": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "exact": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+|[0-9]+/[0-9]+)$"
        }
      ]
    },
    "probability": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+|[0-9]+/[0-9]+)$"
        }
      ]
    },
    "nonnegative": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+|[0-9]+/[0-9]+)$"
        }
      ]
    },
    "timestamp": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time",
          "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      ]
    }
  }
}
