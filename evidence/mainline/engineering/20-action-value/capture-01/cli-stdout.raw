 "control-uncertainty", "value": null, "reason": "UNIDENTIFIED_PROBABILITY_AND_CONSEQUENCE", "evidence_gaps": ["The four-class belief does not identify this domain-specific event probability or conditional consequence.", "Lost reports may increase epistemic uncertainty without physical loss; a genuine control/permission change may constrain service. These alternatives cannot be assigned one probability from current channels.", "Dynamic people, tools, access, authorization and operation effects require executor checks."], "impact_description": "Local controller commands pumps and compute; controller permission affects compute. BMS/point reports feed the evidence inbox. Local protection continues privately during communication loss."}, {"question_id": "access-and-leak", "value": null, "reason": "UNIDENTIFIED_PROBABILITY_AND_CONSEQUENCE", "evidence_gaps": ["The four-class belief does not identify this domain-specific event probability or conditional consequence.", "Blocked access can delay a beneficial action beyond the response window; any later service loss remains one joint-service consequence, not an added penalty per blocked worker.", "Dynamic people, tools, access, authorization and operation effects require executor checks."], "impact_description": "Drainage, gate and room-work conditions constrain loc_it access. Personnel may be unable to inspect or restore equipment although service initially continues."}, {"question_id": "people-and-tools", "value": null, "reason": "UNIDENTIFIED_PROBABILITY_AND_CONSEQUENCE", "evidence_gaps": ["The four-class belief does not identify this domain-specific event probability or conditional consequence.", "Late or infeasible work changes achievable restoration time; absence of a feasible crew is not itself proof of a current plant fault.", "Dynamic people, tools, access, authorization and operation effects require executor checks."], "impact_description": "Workers, compatible tools, qualifications, access routes and shift/resource occupation determine whether a task can start and finish. These are separate from power/fluid dependency graphs."}, {"question_id": "room-boundary", "value": null, "reason": "UNIDENTIFIED_PROBABILITY_AND_CONSEQUENCE", "evidence_gaps": ["The four-class belief does not identify this domain-specific event probability or conditional consequence.", "Room-driven curtailment and access restriction may overlap with liquid-cooling limitations; their service loss must be deduplicated in a joint model.", "Dynamic people, tools, access, authorization and operation effects require executor checks."], "impact_description": "Room conditions influence equipment heat boundary and loc_it work temperature. Immersion thermal protection may curtail compute before personnel can intervene."}], "scope": "SINGLE_NEXT_QUESTION_ALTERNATIVES_NOT_ADDITIVE_GLOBAL_GAIN", "field_calibration": "PENDING", "physical_actions": [], "execution_permission": false, "risk": {"schema": "aegisdc-risk-result-v1", "facility_id": "zhengzhou-inspired-synthetic-full-facility-reserve-v6", "catalog_id": "V6-risk-scenarios-v1", "catalog_basis": "synthetic_assumption", "catalog_source_note": "Finite conditional consequence law using independent literal joint-service examples. Not a physical forecast or site calibration.", "unidentified": ["Conditional profiles are declared consequences given the current aggregate belief, not a prediction of future latent transitions.", "Full-facility hidden causes and field-calibrated failure probabilities are not identified."], "time_unit": "s", "domain_ids": ["power", "backup", "facility_cooling", "equipment_environment", "it_service", "control_monitoring", "space_access", "people_tools_work"], "as_of_s": 12, "status": "UPDATED", "covered_domain_ids": ["backup", "control_monitoring", "equipment_environment", "facility_cooling", "it_service", "people_tools_work", "power", "space_access"], "full_horizon_service": {"offered_service_unit_s": {"value": 2.5, "unit": "normalized_service_