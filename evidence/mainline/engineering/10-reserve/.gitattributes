# Native Windows command logs are preserved, not normalized after capture.
*/*.log -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Acceptance emits native Windows JSON/text; preserve original bytes too.
acceptance-*/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
