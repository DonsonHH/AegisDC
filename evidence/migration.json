  "migration_runner_source": "import hashlib\nimport json\nimport sys\nimport inspect\nimport time\nfrom pathlib import Path\nimport numpy as np\nsys.path.insert(0, str(Path(sys.argv[1]) / 'src'))\nfrom patrol_rsi.reorder_execution import run_reorder\nfrom patrol_rsi.local_score import BASE_EXPRESSION\nfrom patrol_rsi.correction_execution import execute_correction\nfrom patrol_rsi.baseline_correction import Rule\n\ndef native(v):\n    if isinstance(v, np.ndarray): return native(v.tolist())\n    if isinstance(v, np.generic): return native(v.item())\n    if isinstance(v, dict): return {str(k): native(x) for k, x in v.items()}\n    if isinstance(v, (tuple, list)): return [native(x) for x in v]\n    return v\n\ndef digest(v):\n    return hashlib.sha256(json.dumps(native(v), sort_keys=True, separators=(',', ':'), allow_nan=False).encode()).hexdigest()\n\nscenario = 'aux_feeder_loss+cdu_fouling'\nspec = {'seed': 41000, 'scenario': scenario, 'duration_s': 180, 'fault_start_s': 335, 'noise_c': .2, 'estimator': 'nominal'}\nkind = sys.argv[3]\ninputs = []\n\ndef stub(context):\n    inputs.append({'time_s': float(inspect.currentframe().f_back.f_locals['self'].clock), 'input_sha256': digest(context)})\n    return 50. + 20. * context[:, 0].astype(float)\n\nif kind == 'history_stub_T':\n    spec['estimator'] = 'history'\n    policy = {'method': 'T'}\n    record, env = run_reorder(spec, stub, policy)\nelif kind == 'nominal_H':\n    policy = {'kind': 'correction', 'rule': Rule().to_dict()}\n    record, env = execute_correction(spec, None, policy)\nelse:\n    policy = {'method': 'T'} if kind == 'nominal_T' else {'method': 'expression', 'score_expression': BASE_EXPRESSION}\n    record, env = run_reorder(spec, None, policy)\nmetrics = {k:v for k,v in record['metrics'].items() if k != 'history_estimator_inference_s'}\nsummary = {'case': kind, 'specification': spec, 'policy': policy,\n    'process_fingerprint': env.trace.fingerprint,\n    'action_sha256': record['action_sha256'],\n    'measurements_sha256': digest(record['inspection_events']),\n    'assignments_sha256': digest(record['assignments']),\n    'exact_task_gaps_sha256': digest(record['exact_task_gaps']),\n    'metrics': metrics, 'action_steps': len(record['action_log']),\n    'estimator_call_times': [v['time_s'] for v in inputs],\n    'stub_input_sha256': inputs, 'stub_only_not_CVAE_scientific_result': bool(inputs)}\nPath(sys.argv[2]).write_text(json.dumps(native(summary), ensure_ascii=False, indent=2)+'\\n')\nprint(json.dumps({'case':kind, 'actions':record['action_sha256'], 'completed':metrics['completed_inspections'], 'calls':len(inputs)}),flush=True)\n",
